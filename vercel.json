{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "true",
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/player_api.php", "destination": "/api/xtream?ep=player" },
    { "source": "/panel_api.php", "destination": "/api/xtream?ep=player" },
    { "source": "/get.php", "destination": "/api/xtream?ep=get" },
    { "source": "/xmltv.php", "destination": "/api/xtream?ep=xmltv" },
    { "source": "/live/:user/:pass/:file", "destination": "/api/media?ep=live&user=:user&pass=:pass&file=:file" },
    { "source": "/movie/:user/:pass/:file", "destination": "/api/media?ep=live&user=:user&pass=:pass&file=:file" },
    { "source": "/series/:user/:pass/:file", "destination": "/api/media?ep=live&user=:user&pass=:pass&file=:file" },
    { "source": "/ch/:slug", "destination": "/api/media?ep=live&slug=:slug" },
    { "source": "/playlist/:id", "destination": "/api/media?ep=playlist&id=:id" },
    { "source": "/api/stream", "destination": "/api/media?ep=stream" },
    { "source": "/api/proxy", "destination": "/api/media?ep=proxy" },
    { "source": "/api/playlist", "destination": "/api/media?ep=playlist" },
    { "source": "/blog/feed.xml", "destination": "/api/seo?ep=rss" },
    { "source": "/blog", "destination": "/api/seo?ep=blog" },
    { "source": "/blog/:slug", "destination": "/api/seo?ep=blog&slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/seo?ep=sitemap" },
    { "source": "/rss.xml", "destination": "/api/seo?ep=rss" },
    { "source": "/llms.txt", "destination": "/api/seo?ep=llms" },
    { "source": "/llms-full.txt", "destination": "/api/seo?ep=llms&full=1" },
    { "source": "/.well-known/ai.txt", "destination": "/api/seo?ep=llms" },
    { "source": "/barakatwave2026mizanoraseokey.txt", "destination": "/api/seo?ep=indexnow&verify=1" },
    { "source": "/api/seo/indexnow", "destination": "/api/seo?ep=indexnow" },
    { "source": "/api/probe", "destination": "/api/admin?ep=probe" },
    { "source": "/api/sync", "destination": "/api/admin?ep=sync" },
    { "source": "/api/github/push", "destination": "/api/admin?ep=github_push" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/media/(.*)\\.m2ts",
      "headers": [
        { "key": "Content-Type", "value": "video/mp2t" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/media/(.*)\\.m3u8",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.apple.mpegurl; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
