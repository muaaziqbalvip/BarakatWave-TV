# ==========================================================================
# BarakatWave Live TV — Server Environment Variables (Vercel)
# Works out of the box with Firebase Realtime Database (barakatwave-tv).
# Add these in Vercel -> Project Settings -> Environment Variables.
# ==========================================================================

PUBLIC_BASE_URL=https://barakatwave.vercel.app
FIREBASE_DATABASE_URL=https://barakatwave-tv-default-rtdb.firebaseio.com
FIREBASE_API_KEY=AIzaSyB1aWw27UEteaspMte4wTp_nUWEf07FqwQ

# --------------------------------------------------------------------------
# IPTV RESELLER PANEL (orders, dealers, credits, clients)
# --------------------------------------------------------------------------
# REQUIRED for the panel to persist orders/dealers/clients in Firebase.
# Firebase Console -> Realtime Database -> Rules keeps /panel server-only,
# so the serverless functions need the database secret to read/write it.
# Project Settings -> Service accounts -> Database secrets (legacy) OR
# use a long-lived OAuth token / database secret value here.
FIREBASE_DATABASE_SECRET=

# Signing secret for HMAC signed playback links + Owner PIN sessions.
# Generate a long random string (e.g. `openssl rand -hex 32`) and NEVER rotate
# it casually — rotating invalidates all issued tokens (users just re-login).
BARAKATWAVE_SIGNING_SECRET=

# Owner admin PIN (used by /admin.html and /reseller admin tab when Firebase
# login is unavailable, e.g. domain not yet authorized in Firebase Console).
# If unset, the documented bootstrap PIN 03062015326 is used until you change
# it from Admin -> Security (stored as a hash at settings/private/adminPinHash).
BARAKATWAVE_ADMIN_PIN=

# Optional server-to-server admin token for scripts/CI (sent as x-admin-token)
BARAKATWAVE_ADMIN_TOKEN=
BW_OWNER_EMAIL=muaaziqbal.vip@gmail.com

# Signed playback link lifetime in seconds (default 900 = 15 minutes)
BW_LINK_TTL_SEC=900

# --------------------------------------------------------------------------
# Optional: GitHub M3U8 publishing + search console verification
# --------------------------------------------------------------------------

# --- Shared with speed/login optimisation branch ---
# Required for server-side access to restricted Xtream and playlist records
# Store only in the server environment, never in frontend code or Git.
FIREBASE_DATABASE_SECRET=

# Required for production: set a long random secret; the legacy fallback is public.
BARAKATWAVE_SIGNING_SECRET=

# Optional: Default GitHub PAT for server-side M3U8 publishing (can also be entered directly in Admin Panel)
GITHUB_TOKEN=
GITHUB_REPO=muaaziqbalvip/BarakatWave-TV
GITHUB_BRANCH=main
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=barakatwave2026mizanoraseokey
